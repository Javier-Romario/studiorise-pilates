---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import SmallByDesign from '../components/SmallByDesign.astro';
import Classes from '../components/Classes.astro';
import Words from '../components/Words.astro';
import Visit from '../components/Visit.astro';
import Booking from '../components/Booking.astro';
import Footer from '../components/Footer.astro';
import { content } from '../lib/content';
---

<Base title={`${content.meta.fullName} — ${content.meta.tagline}`} description={content.hero.subtitle}>
  <TopBar brand={content.meta.siteName} nav={content.nav} cta={{ label: 'Book a class', href: '#book' }} />

  <main>
    <Hero data={content.hero} />
    <SmallByDesign data={content.smallByDesign} />
    <Classes data={content.classes} />
    <Words data={content.words} />
    <Visit data={content.visit} />
  </main>

  <Booking data={content.booking} />

  <Footer
    meta={content.meta}
    nav={content.nav}
    footer={content.footer}
    locations={content.visit.locations}
  />

  <script>
    import '../scripts/site.ts';
  </script>
</Base>
