---
import { asset } from '../lib/base';
import type { Booking } from '../lib/types';

interface Props {
  data: Booking;
}

const { data } = Astro.props;

const src = (data.glofox?.src ?? '').trim();
// treat obviously-placeholder values as "not connected yet"
const connected = src.length > 0 && !/replace|branch[-_ ]?id|example/i.test(src);
---

<section class="booking" id={data.id}>
  <div class="booking__inner">
    <p class="eyebrow">{data.eyebrow}</p>
    <h2 class="section-heading">{data.heading}</h2>
    <p class="section-lead">{data.intro}</p>

    {
      connected ? (
        <div class="booking__frame">
          <iframe
            src={src}
            title={`${data.heading} — class booking`}
            loading="lazy"
            style={`height: ${data.glofox.height ?? 820}px`}
          ></iframe>
        </div>
      ) : (
        <div class="booking__placeholder">
          <p class="booking__placeholder-title">Class booking is being connected.</p>
          <p>
            Paste your Glofox embed link into <code>booking.glofox.src</code> (via the
            admin page or <code>src/data/content.json</code>) and it will appear here.
          </p>
          <a class="text-link" href={asset('/admin')}>Open admin</a>
        </div>
      )
    }
  </div>
</section>

<style>
  .booking {
    position: relative;
    z-index: 2;
    background: var(--chalk);
    color: var(--espresso);
    padding: clamp(4rem, 9vw, 7rem) clamp(1.25rem, 5vw, 4rem);
    text-align: center;
    scroll-snap-align: start;
  }

  .booking__inner {
    max-width: 76rem;
    margin: 0 auto;
  }

  .booking .section-lead {
    color: rgba(128, 84, 64, 0.78);
  }

  .booking__frame {
    margin-top: 2.75rem;
    border: 1px solid var(--bone);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 40px 80px -50px rgba(28, 23, 19, 0.45);
    background: #fff;
  }

  .booking__frame iframe {
    display: block;
    width: 100%;
    border: 0;
    max-height: 85vh;
  }

  .booking__placeholder {
    margin-top: 2.75rem;
    padding: 3rem 1.5rem;
    border: 1px dashed var(--almond-deep);
    border-radius: 14px;
    color: rgba(128, 84, 64, 0.72);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .booking__placeholder-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--espresso);
    margin-bottom: 0.5rem;
  }

  .booking__placeholder code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.85em;
    color: var(--espresso);
    background: var(--bone);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }

  .booking__placeholder .text-link {
    margin-top: 1.25rem;
    color: var(--espresso);
  }
</style>
